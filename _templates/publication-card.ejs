```{=html}
<div class="list c-pub-list">
<% for (const item of items) { %>
  <div class="c-pub" <%= metadataAttrs(item) %>>
    <div class="c-pub-year listing-year"><%= item.year %></div>
    <div>
      <h3 class="c-pub-title listing-title">
        <% if (item.doi) { %>
          <a href="<%- item.doi %>" target="_blank" rel="noopener noreferrer"><%= item.title %></a>
        <% } else { %>
          <%= item.title %>
        <% } %>
      </h3>
      <p class="c-pub-authors listing-author"><%= item.author %></p>
      <p class="c-pub-venue listing-journal"><%= item.journal %></p>
      <div>
        <% if (item.categories) { %>
          <% for (const cat of item.categories) { %>
            <span class="c-tag c-tag--accent"><%= cat %></span>
          <% } %>
        <% } %>
        <% if (item.doi) { %>
        <a href="<%- item.doi %>" class="c-tag" target="_blank" rel="noopener noreferrer">DOI</a>
        <% } %>
        <% if (item.preprint) { %>
        <a href="<%- item.preprint %>" class="c-tag" target="_blank" rel="noopener noreferrer">Preprint</a>
        <% } %>
        <% if (item.materials) { %>
        <a href="<%- item.materials %>" class="c-tag" target="_blank" rel="noopener noreferrer">Materials</a>
        <% } %>
      </div>
    </div>
  </div>
<% } %>
</div>
```
