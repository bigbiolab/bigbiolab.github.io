```{=html}
<div class="list c-grid-3">
<% for (const item of items) { %>
  <article class="c-card" <%= metadataAttrs(item) %>>
    <span class="c-card-meta"><%= item.kind || "Partner institution" %></span>
    <h3 class="listing-title<%= item.todo ? ' c-todo' : '' %>"><%= item.title %></h3>
    <p><%= item.description %></p>
    <% if (item.href) { %>
      <a class="c-card-link" href="<%- item.href %>">Visit →</a>
    <% } %>
  </article>
<% } %>
</div>
```
