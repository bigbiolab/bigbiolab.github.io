```{=html}
<div class="list c-people-grid">
<% for (const item of items) { %>
  <article class="c-person" <%= metadataAttrs(item) %>>
    <% if (item.image) { %>
      <img class="c-person-img" src="<%- item.image %>" alt="<%= item.title %>" loading="lazy">
    <% } else { %>
      <span class="c-person-img c-person-img--empty" aria-hidden="true"></span>
    <% } %>
    <p class="c-person-name listing-title"><%= item.title %></p>
    <p class="c-person-role listing-subtitle"><%= item.role %></p>
    <ul class="c-person-social">
      <li><a<% if (item.linkedin) { %> href="<%- item.linkedin %>"<% } %> aria-label="<%= item.title %> on LinkedIn"><i class="bi bi-linkedin"></i></a></li>
      <li><a<% if (item.github) { %> href="<%- item.github %>"<% } %> aria-label="<%= item.title %> on GitHub"><i class="bi bi-github"></i></a></li>
    </ul>
  </article>
<% } %>
</div>
```
