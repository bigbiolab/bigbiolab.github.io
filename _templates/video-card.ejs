```{=html}
<div class="list c-grid-3">
<% for (const item of items) { %>
  <article class="c-card" <%= metadataAttrs(item) %>>
    <% if (item.categories && item.categories.length) { %>
      <span class="c-card-meta"><%= item.categories.join(' · ') %></span>
    <% } %>
    <h3 class="listing-title"><%= item.course %></h3>
    <p><%= item.description %></p>
    <% if (item.playlist) { %>
      <a class="c-card-link" href="<%- item.playlist %>" target="_blank" rel="noopener noreferrer">Watch the playlist →</a>
    <% } %>
  </article>
<% } %>
</div>
```
