```{=html}
<div class="list c-grid-quad">
<% for (const item of items) { %>
  <article class="c-card" <%= metadataAttrs(item) %>>
    <% if (item.category) { %><span class="c-card-meta"><%= item.category %></span><% } %>
    <h3 class="listing-title"><%= item.title %></h3>
    <p><%= item.description %></p>
    <% if (item.input || item.output) { %>
      <dl class="c-io">
        <% if (item.input) { %><dt>In</dt><dd><%= item.input %></dd><% } %>
        <% if (item.output) { %><dt>Out</dt><dd><%= item.output %></dd><% } %>
      </dl>
    <% } %>
    <% if (item.tools && item.tools.length) { %>
      <div class="c-tag-row"><% for (const tool of item.tools) { %><span class="c-tag"><%= tool %></span><% } %></div>
    <% } %>
    <% if (item.links && item.links.length) { %>
      <div class="c-card-links">
        <% for (const link of item.links) { %>
          <a class="c-card-link" href="<%- link.url %>" target="_blank" rel="noopener noreferrer"><%= link.label %> →</a>
        <% } %>
      </div>
    <% } %>
  </article>
<% } %>
</div>
```
